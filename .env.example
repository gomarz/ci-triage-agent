# Copy to .env and fill in. Never commit .env.

# GitHub personal access token, scope: actions:read, contents:read
GITHUB_TOKEN=

# Repository to ingest failures from, as owner/name
TARGET_REPO=gomarz/SS-armaa

# Where a corpus is cached (raw/runs, raw/jobs, raw/logs). Give each repo its
# own directory so one corpus's logs do not mix into another's counts.
# DATA_DIR=data

# AWS
AWS_REGION=us-west-2

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
